// Read ONLY by @sveltejs/adapter-cloudflare at build time (see vite.config.ts).
// The adapter writes its bundle to `main`; the real entry in wrangler.jsonc (src/worker/index.ts)
// imports this output and adds the `scheduled` handler. Keep `assets` identical to wrangler.jsonc.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "jptype",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-10",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	}
}
