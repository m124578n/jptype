{
	"name": "jptype",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.3.4",
	"engines": {
		"node": ">=22",
		"pnpm": ">=12"
	},
	"scripts": {
		"dev": "pnpm --filter web dev",
		"preview": "pnpm --filter web preview",
		"build": "pnpm --filter web build",
		"check": "pnpm -r --if-present check",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "pnpm -r --if-present test",
		"test:coverage": "pnpm -r --if-present test:coverage",
		"validate:data": "pnpm --filter @jptype/data validate",
		"ci": "pnpm lint && pnpm check && pnpm validate:data && pnpm test:coverage && pnpm build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"typescript": "catalog:",
		"typescript-eslint": "^8.60.1"
	}
}
